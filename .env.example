# ==============================================================================
# Agri Rakshak - Environment Configuration Template
# Smart India Hackathon 2026 (SIH26131)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env
# 2. NEVER commit '.env' or any credentials to Git (enforced via .gitignore).
# 3. NEVER prefix server-side secrets with VITE_ (VITE_ variables are bundled into browser JS).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Exposed to Browser Client)
# ------------------------------------------------------------------------------
# Public API base endpoint accessed by the farmer's/officer's browser
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection (Server-Side Only)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_rakshak?schema=public

# Database strict mode:
# Set to 'true' to require PostgreSQL and abort startup if database is unreachable.
# In 'false' (or omitted during development), the backend falls back to standalone in-memory store.
# Automatically treated as 'true' when NODE_ENV=production.
DATABASE_REQUIRED=false

# Docker compose default:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/agri_rakshak?schema=public

# ------------------------------------------------------------------------------
# 4. Groq AI Pathology Engine (Server-Side Only - STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. Security & Authentication (Server-Side Only)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session HMAC-SHA256 tokens (min 32 characters)
AUTH_SECRET=agri-rakshak-dev-secret-change-to-random-string-in-production

# Comma-separated list of allowed HTTP origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Secret Rotation Procedure:
# If any secret is accidentally committed or exposed:
# 1. Groq API Key: Immediately revoke and regenerate key at https://console.groq.com/keys
# 2. Database Password: Alter PostgreSQL role password via ALTER ROLE postgres WITH PASSWORD '...';
# 3. AUTH_SECRET: Change AUTH_SECRET in production environment settings (all active tokens will expire safely).
# 4. Check git history using git filter-repo or BFG Repo-Cleaner if accidentally committed.
# ------------------------------------------------------------------------------
